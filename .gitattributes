# Keep LF line endings for text files on every OS.
# This prevents CRLF churn/warnings on Windows (e.g. with core.autocrlf=true).
* text=auto eol=lf

# Windows command scripts are typically expected to be CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly mark common text formats (helps for uncommon extensions).
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.pd text eol=lf
*.pio text eol=lf
*.ld text eol=lf
*.map text eol=lf
*.bdf text eol=lf
*.ino text eol=lf
*.uno text eol=lf
*.leonardo text eol=lf
*.feather32u4 text eol=lf
*.duemilanove text eol=lf
*.info text eol=lf
*.xbm text eol=lf

# Denote files that are truly binary and should not be modified.
*.uf2 binary
