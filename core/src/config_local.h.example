/**
 * Local (not tracked) firmware configuration overrides.
 *
 * Copy this file to `config_local.h` and adjust values for your hardware:
 *   core/src/config_local.h
 *
 * Note: `config_local.h` is ignored by git (see .gitignore).
 *
 * USB MIDI is a build-time option:
 * - Preferred: pass `--usb-midi` to the build script
 * - Alternative: pass `-D ENABLE_USB_MIDI=ON`
 * Do not #define ENABLE_USB_MIDI here (CMake defines it when the option is ON).
 * Optional in config_local.h: #define USB_MIDI_DEVICE_NAME "MyDevice"
 *
 * USB Audio (host -> device, for adc~) is also a build-time option:
 *   -D ENABLE_USB_AUDIO=ON
 * Optional in config_local.h:
 *   - #define USB_AUDIO_RING_FRAMES 2048
 *   - #define USB_AUDIO_TARGET_FILL_FRAMES 512
 */

#ifndef CONFIG_LOCAL_H
#define CONFIG_LOCAL_H

// I2S: use pico-extras' PICO_AUDIO_I2S_* macros (same as in config.h defaults).
// Example for a board with DIN=5, LRCLK=6, BCLK=7 (consecutive clock pins).
// When PICO_AUDIO_I2S_CLOCK_PINS_SWAPPED is 0: base = LRCLK, base+1 = BCLK.

#define PICO_AUDIO_I2S_DATA_PIN 5
#define PICO_AUDIO_I2S_CLOCK_PIN_BASE 6
#define PICO_AUDIO_I2S_CLOCK_PINS_SWAPPED 0

// Potentiometers (Daisy-style knob1..knob4). Config by ADC channels; physical pins come from SDK (chip-dependent).
// Disabled by default; uncomment below to enable. In the patch use [r knob1 @hv_param 0 1 0] etc.
// If POTS_BACKEND is NONE (or POTS_COUNT 0), knob* receivers get no values.
// On RP2350B, channels 0..7 are available; you can set POTS_ADC_FIRST_CHANNEL to e.g. 4 if 0..3 are used elsewhere.
// #define POTS_BACKEND POTS_BACKEND_ADC
// #define POTS_COUNT 4
// #define POTS_ADC_FIRST_CHANNEL 0
// #define POTS_POLL_MS 8
// #define POTS_EPS 0.005f
// #define POTS_ALPHA 0.25f

// USB bring-up / main-loop timing (optional overrides).
// #define USB_INIT_ITERATIONS 100
// #define USB_INIT_DELAY_MS 1
// #define MAIN_LOOP_SLEEP_US 100

// System clock profile (RP2350)
//
// Default repo behavior: FW_SYS_CLOCK_PROFILE_DEFAULT (SDK default 150 MHz on RP2350).
// Uncomment to test 240 MHz OC profile from config.h:
// #define FW_SYS_CLOCK_PROFILE FW_SYS_CLOCK_PROFILE_OC_240MHZ
// Or force the same profile from build CLI (explicit override):
//   python scripts/build_firmware.py <patch.pd> --overclocked
//
// Advanced manual override (if you want custom frequency/PLL tuple):
// #define SYS_CLK_HZ 200000000
// #define PLL_SYS_REFDIV 1
// #define PLL_SYS_VCO_FREQ_HZ 1200000000
// #define PLL_SYS_POSTDIV1 6
// #define PLL_SYS_POSTDIV2 1
//
// Flash/XIP tuning for OC experiments (board-specific):
// NOTE: boot stage2 is built separately, so set this via build script CMake define:
//   python scripts/build_firmware.py <patch.pd> -D PICO_FLASH_SPI_CLKDIV=4
//
// Optional VREG policy for higher clocks:
// #define SYS_CLK_VREG_VOLTAGE_AUTO_ADJUST 1
// #define SYS_CLK_VREG_VOLTAGE_MIN VREG_VOLTAGE_1_15

// UI input baseline (Phase 2, MultiButton backend).
// Defaults in config.h are:
// - UI_INPUT_ENABLED: ON when ENABLE_OLED=ON, else OFF
// - UI_INPUT_TICK_MS: 5 (align with MultiButton defaults)
// - pins: LEFT=15, CENTER=14, RIGHT=13
//
// Uncomment and tune for your board wiring.
// #define UI_INPUT_ENABLED 1
// #define UI_INPUT_TICK_MS 5
// #define UI_INPUT_EVENT_QUEUE_SIZE 16
// #define UI_BTN_ACTIVE_LOW 1
// #define UI_BTN_LEFT_PIN 15
// #define UI_BTN_CENTER_PIN 14
// #define UI_BTN_RIGHT_PIN 13

// SSD1306 OLED (u8g2) over I2C (optional)
//
// I2C bus configuration:
// - Preferred overrides: I2C_BUS0_* / I2C_BUS1_* (neutral naming for all I2C peripherals)
// - Legacy: I2C_BUS_* / OLED_I2C_* still work, but map to bus 0 only.
//
// Default in repo: SDA=GPIO2, SCL=GPIO3, addr=0x3C (often I2C1), 1 MHz.
// Frame period and waveform decimation are derived from OLED_REFRESH_FPS.
// Uncomment and override if your wiring differs. If 1 MHz is unstable, try 400000.
//
// #define OLED_REFRESH_FPS 60  // display FPS; frame ms and wave decim are derived
// #define I2C_BUS0_INSTANCE 1  // 0 = i2c0, 1 = i2c1
// #define I2C_BUS0_SDA_PIN 2
// #define I2C_BUS0_SCL_PIN 3
// #define I2C_BUS0_BAUD 1000000  // 1 MHz; use 400000 if bus glitches
// #define I2C_BUS0_TIMEOUT_US 5000
// #define OLED_I2C_ADDR 0x3C
// #define OLED_I2C_BUS_ID 0
// #define MPR121_I2C_BUS_ID 0
//
// Optional second bus (example; verify pin mux in datasheet / SDK):
// #define I2C_BUS1_INSTANCE 0
// #define I2C_BUS1_SDA_PIN 4
// #define I2C_BUS1_SCL_PIN 5
// #define I2C_BUS1_BAUD 400000
// #define OLED_WIDTH 128
// #define OLED_HEIGHT 64

// MPR121 touch thresholds (0..255). Lower = more sensitive. If some pads (e.g. 2,3) don't trigger, try lower values.
// Touch must be > release. Defaults: 16, 10.
// #define MPR121_TOUCH_THRESHOLD 12
// #define MPR121_RELEASE_THRESHOLD 8

#endif // CONFIG_LOCAL_H
